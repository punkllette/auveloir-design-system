---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import LogoMark from '../components/LogoMark.astro';
---

<Layout>
  <svg slot="icons" class="icon-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
    <symbol id="i-repeat" viewBox="0 0 24 24"><path d="M4 7h15l-3-3m3 3-3 3M20 17H5l3 3m-3-3 3-3"/></symbol>
    <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 2 2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2Z"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="m21 3-7.5 18-2.8-7.7L3 10.5 21 3Zm-10.3 10.3L21 3"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 9h18m-4 5h.01"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M5 5 19 19M19 5 5 19"/></symbol>
  </svg>

  <aside slot="sidebar" class="sidebar" aria-label="Menu principal">
      <div class="sidebar-top">
        <a class="brand" href="/" aria-label="Nexo — voltar à página inicial"><LogoMark class="brand-mark" /><span>Nexo<span class="brand-dot">.</span></span></a>
        <button class="workspace-label" type="button" data-open-settings aria-haspopup="dialog" aria-controls="settings-dialog">ESPAÇO PESSOAL <span class="workspace-chevron" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
      </div>
      <nav class="side-nav" aria-label="Navegação">
        <span class="nav-caption">VISÃO FINANCEIRA</span>
        <Button class="nav-link is-active" data-view="overview" aria-label="Visão geral" aria-current="page"><svg class="icon"><use href="#i-grid"></use></svg><span>Visão geral</span></Button>
        <Button class="nav-link" data-view="transactions" aria-label="Transações"><svg class="icon"><use href="#i-repeat"></use></svg><span>Transações</span><span class="nav-count" id="nav-tx-count"></span></Button>
        <Button class="nav-link" data-view="goals" aria-label="Metas"><svg class="icon"><use href="#i-target"></use></svg><span>Metas</span></Button>
        <span class="nav-caption nav-caption-second">ASSISTÊNCIA</span>
        <Button class="nav-link" data-view="assistant" aria-label="Assistente"><svg class="icon"><use href="#i-spark"></use></svg><span>Assistente</span><span class="spark-dot"></span></Button>
      </nav>
      <div class="sidebar-bottom">
        <a class="sidebar-note" href="/planos"><span class="note-icon">✦</span><strong>Mais clareza.<br>Menos ruído.</strong><p>Conheça os planos Nexo <span aria-hidden="true">↗</span></p></a>
        <button class="profile" type="button" data-open-settings aria-label="Abrir meus dados"><span class="avatar" id="profile-avatar">LM</span><span><strong id="profile-name">Luiza Martins</strong><small id="profile-subtitle">Dados demonstrativos</small></span><span class="profile-more" aria-hidden="true">⚙</span></button>
      </div>
    </aside>

      <main id="main-content" tabindex="-1">
        <section class="view" id="view-overview" aria-labelledby="overview-title">
          <div class="page-intro">
            <div><p class="eyebrow"><span></span> SEU PAINEL FINANCEIRO</p><h1 id="overview-title">Bom dia, Luiza<span class="title-period">.</span></h1><p class="intro-copy">Uma visão clara do que entra, sai e fica.</p></div>
            <label class="period-control"><span>PERÍODO</span><span class="select-wrap"><svg class="icon"><use href="#i-calendar"></use></svg><select id="period-select" aria-label="Selecione o mês de referência"></select></span></label>
          </div>

          <div class="overview-grid">
            <Card variant="balance"><div class="balance-glow" aria-hidden="true"></div><div class="balance-top"><span>SALDO DO PERÍODO</span><svg class="icon"><use href="#i-wallet"></use></svg></div><div class="balance-value" id="balance-value">—</div><p id="balance-caption">Receitas menos despesas do mês</p><div class="balance-footer"><span><span class="live-dot"></span> Salvo neste navegador</span><span id="balance-period">—</span></div></Card>
            <Card variant="metric"><div class="metric-top"><span>RECEITAS</span><span class="metric-icon income-icon">↗</span></div><strong id="income-value">—</strong><p>Entradas registradas no período</p><div class="metric-bottom"><span class="mini-rule income-rule"></span><span id="income-count">—</span></div></Card>
            <Card variant="metric"><div class="metric-top"><span>DESPESAS</span><span class="metric-icon expense-icon">↘</span></div><strong id="expense-value">—</strong><p>Gastos e saídas do período</p><div class="metric-bottom"><span class="mini-rule expense-rule"></span><span id="expense-count">—</span></div></Card>
          </div>

          <div class="overview-content-grid">
            <Card class="chart-panel"><div class="panel-heading"><div><span class="panel-kicker">FLUXO DO MÊS</span><h2>Evolução financeira</h2></div><span class="panel-detail" id="chart-period-label">—</span></div><div id="finance-chart" class="chart-wrap" role="group" aria-label="Gráfico interativo da evolução do saldo do mês" tabindex="0" aria-describedby="chart-help"></div><div class="chart-legend"><span><i class="legend-gold"></i> Saldo acumulado</span><span id="chart-help">Passe o mouse ou use ← → para explorar os dias</span></div></Card>
            <Card class="assistant-callout"><div class="callout-orb" aria-hidden="true"></div><span class="callout-icon"><svg class="icon"><use href="#i-spark"></use></svg></span><span class="panel-kicker">UM JEITO MAIS NATURAL</span><h2>Suas finanças<br><em>em conversa.</em></h2><p>“Gastei R$ 42 no almoço hoje.” Conte como foi e confira o lançamento antes de registrar.</p><Button class="shiny-cta callout-button" data-view="assistant">Registrar por conversa <svg class="icon"><use href="#i-arrow"></use></svg></Button><small>Simulação local · nenhuma IA ou envio de dados</small></Card>
          </div>

          <div class="overview-content-grid bottom-grid">
            <Card class="recent-panel"><div class="panel-heading"><div><span class="panel-kicker">ATIVIDADE</span><h2>Transações recentes</h2></div><Button class="text-link" data-view="transactions">Ver todas <svg class="icon"><use href="#i-arrow"></use></svg></Button></div><div id="recent-transactions" class="transaction-list"></div></Card>
            <Card class="goals-panel"><div class="panel-heading"><div><span class="panel-kicker">SEUS PLANOS</span><h2>Metas em andamento</h2></div><Button class="text-link" data-view="goals">Ver metas <svg class="icon"><use href="#i-arrow"></use></svg></Button></div><div id="overview-goals"></div></Card>
          </div>
        </section>

        <section class="view" id="view-transactions" aria-labelledby="transactions-title" hidden>
          <div class="page-intro page-intro-secondary"><div><p class="eyebrow"><span></span> CONTROLE EM DETALHE</p><h1 id="transactions-title">Transações<span class="title-period">.</span></h1><p class="intro-copy">Encontre e organize seus lançamentos.</p></div><Button class="button-primary" id="open-transaction"><svg class="icon"><use href="#i-plus"></use></svg> Novo lançamento</Button></div>
          <Card as="section" class="filters-panel" aria-label="Filtros de transações"><div class="filter-title"><span class="panel-kicker">ENCONTRE O QUE PROCURA</span><Button class="text-link" id="clear-filters">Limpar filtros</Button></div><div class="filters-grid"><label class="search-field"><span>Buscar</span><span class="input-wrap"><svg class="icon"><use href="#i-search"></use></svg><input id="filter-search" type="search" placeholder="Descrição ou categoria" autocomplete="off"></span></label><label><span>Tipo</span><select id="filter-type"><option value="">Todos os tipos</option><option value="receita">Receitas</option><option value="despesa">Despesas</option></select></label><label><span>Categoria</span><select id="filter-category"><option value="">Todas as categorias</option></select></label><label><span>De</span><input id="filter-start" type="date"></label><label><span>Até</span><input id="filter-end" type="date"></label></div></Card>
          <Card as="section" class="transaction-panel"><div class="panel-heading"><div><span class="panel-kicker">HISTÓRICO</span><h2>Seus lançamentos</h2></div><span class="panel-detail" id="transaction-count">—</span></div><div class="filtered-summary"><span>Receitas <strong id="filtered-income">—</strong></span><span>Despesas <strong id="filtered-expense">—</strong></span><span>Saldo <strong id="filtered-balance">—</strong></span></div><div id="all-transactions" class="transaction-list"></div><p id="transactions-empty" class="empty-state" hidden>Nenhuma transação encontrada. Ajuste a busca ou os filtros.</p></Card>
        </section>

        <section class="view" id="view-goals" aria-labelledby="goals-title" hidden><div class="page-intro page-intro-secondary"><div><p class="eyebrow"><span></span> SONHOS COM DIREÇÃO</p><h1 id="goals-title">Metas<span class="title-period">.</span></h1><p class="intro-copy">Acompanhe o caminho entre o seu hoje e os seus próximos marcos.</p></div><div class="goals-heading-actions"><span class="goals-total" id="goals-total">—</span><Button class="button-primary" id="open-goal"><svg class="icon"><use href="#i-plus"></use></svg> Nova meta</Button></div></div><div id="all-goals" class="goal-cards"></div><div class="goals-note"><span>✦</span><p id="goals-note-text">Metas ilustrativas; seus valores são independentes das transações.</p></div></section>

        <section class="view" id="view-assistant" aria-labelledby="assistant-title" hidden><div class="page-intro page-intro-secondary"><div><p class="eyebrow"><span></span> REGISTRO POR CONVERSA</p><h1 id="assistant-title">Assistente<span class="title-period">.</span></h1><p class="intro-copy">Escreva naturalmente. Você sempre revisa e confirma antes de registrar.</p></div><span class="sim-badge">✦ SIMULAÇÃO LOCAL</span></div><div class="assistant-layout"><Card as="div" class="chat-panel"><div class="chat-header"><span class="chat-avatar"><svg class="icon"><use href="#i-spark"></use></svg></span><span><strong>Assistente Nexo</strong><small>Simulação demonstrativa · sem IA real</small></span><span class="chat-status"><i></i> Disponível</span></div><div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-relevant="additions"></div><div class="chat-composer"><div class="suggestions"><Button type="button" data-suggestion="Gastei R$ 42 no almoço hoje">Gastei R$ 42 no almoço</Button><Button type="button" data-suggestion="Recebi R$ 3.000 de salário hoje">Recebi meu salário</Button></div><form id="chat-form"><label class="sr-only" for="chat-input">Mensagem para o assistente</label><input id="chat-input" name="message" type="text" autocomplete="off" placeholder="Ex.: Gastei R$ 42 no almoço hoje" maxlength="180" required><Button type="submit" aria-label="Enviar mensagem"><svg class="icon"><use href="#i-send"></use></svg></Button></form><small>O texto é interpretado por regras locais simples. Nenhuma informação sai do navegador.</small></div></Card><Card as="aside" class="assistant-side"><span class="panel-kicker">COMO FUNCIONA</span><h2>Você no controle<br>de cada registro.</h2><ol><li><span>01</span><p>Descreva um gasto ou uma receita com valor.</p></li><li><span>02</span><p>Confira a sugestão gerada pela simulação.</p></li><li><span>03</span><p>Confirme para salvar no navegador.</p></li></ol><div class="privacy-note"><svg class="icon"><use href="#i-check"></use></svg><span>Só registros confirmados são salvos no navegador.</span></div></Card></div></section>
      </main>
  <Fragment slot="overlays">
  <dialog id="transaction-dialog" aria-labelledby="dialog-title"><form id="transaction-form" novalidate><div class="dialog-top"><div><p class="panel-kicker">REGISTRO MANUAL</p><h2 id="dialog-title">Novo lançamento</h2></div><Button type="button" class="icon-button" id="close-transaction" aria-label="Fechar formulário"><svg class="icon"><use href="#i-close"></use></svg></Button></div><div class="form-grid"><label><span>Tipo</span><select id="transaction-type" name="type" required><option value="despesa">Despesa</option><option value="receita">Receita</option></select></label><label><span>Valor (R$)</span><input id="transaction-amount" name="amount" type="text" inputmode="decimal" placeholder="0,00" required></label><label class="full"><span>Descrição</span><input id="transaction-description" name="description" type="text" placeholder="Ex.: Almoço" maxlength="70" required></label><label><span>Categoria</span><select id="transaction-category" name="category" required></select></label><label><span>Data</span><input id="transaction-date" name="date" type="date" required></label></div><p class="form-error" id="transaction-error" role="alert" hidden></p><div class="dialog-actions"><Button type="button" class="button-secondary" id="cancel-transaction">Cancelar</Button><Button type="submit" class="button-primary" id="transaction-submit">Adicionar transação <svg class="icon"><use href="#i-arrow"></use></svg></Button></div></form></dialog>
  <dialog id="goal-dialog" aria-labelledby="goal-dialog-title"><form id="goal-form" novalidate><div class="dialog-top"><div><p class="panel-kicker">SEUS PLANOS</p><h2 id="goal-dialog-title">Nova meta</h2></div><Button type="button" class="icon-button" data-close-dialog="goal-dialog" aria-label="Fechar formulário"><svg class="icon"><use href="#i-close"></use></svg></Button></div><div class="form-grid"><label class="full"><span>Nome da meta</span><input id="goal-name" maxlength="55" placeholder="Ex.: Reserva de emergência" required></label><label><span>Objetivo (R$)</span><input id="goal-target" inputmode="decimal" placeholder="0,00" required></label><label><span>Já acumulado (R$)</span><input id="goal-current" inputmode="decimal" placeholder="0,00" required></label><label class="full"><span>Descrição breve</span><input id="goal-description" maxlength="100" placeholder="Por que essa meta importa?"></label><label><span>Previsão</span><input id="goal-due" type="month" required></label></div><p class="form-error" id="goal-error" role="alert" hidden></p><div class="dialog-actions"><Button type="button" class="button-secondary" data-close-dialog="goal-dialog">Cancelar</Button><Button type="submit" class="button-primary" id="goal-submit">Salvar meta <svg class="icon"><use href="#i-arrow"></use></svg></Button></div></form></dialog>
  <dialog id="settings-dialog" aria-labelledby="settings-title"><div class="dialog-top"><div><p class="panel-kicker">SEU ESPAÇO</p><h2 id="settings-title">Meus dados</h2></div><Button type="button" class="icon-button" data-close-dialog="settings-dialog" aria-label="Fechar configurações"><svg class="icon"><use href="#i-close"></use></svg></Button></div><p class="settings-copy">Este é um protótipo. Seus lançamentos e metas ficam somente neste navegador, sem conta ou sincronização.</p><form id="profile-form" class="settings-form"><label><span>Como podemos chamar você?</span><input id="user-name" maxlength="40" autocomplete="given-name" required></label><Button type="submit" class="button-primary">Salvar nome</Button></form><div class="settings-divider"></div><div class="settings-mode"><strong id="data-mode-title">Demonstração</strong><p id="data-mode-description">Explore com dados ilustrativos ou comece um espaço vazio para usar seus próprios dados.</p><Button type="button" class="button-secondary" id="switch-data-mode">Começar com meus dados</Button></div><div class="settings-divider"></div><div class="settings-backup"><strong>Backup local</strong><p>Baixe seus dados em JSON para guardar uma cópia ou restaurá-los neste navegador. O arquivo pode conter informações financeiras pessoais.</p><div class="backup-actions"><Button type="button" class="button-secondary" id="export-data">Exportar dados</Button><Button type="button" class="button-secondary" id="import-data">Importar backup</Button><input id="import-file" type="file" accept=".json,application/json" aria-label="Selecionar backup JSON" hidden></div></div></dialog>
  <dialog id="confirm-dialog" aria-labelledby="confirm-title"><div class="dialog-top"><div><p class="panel-kicker">CONFIRMAÇÃO</p><h2 id="confirm-title">Confirmar ação</h2></div><Button type="button" class="icon-button" data-close-dialog="confirm-dialog" aria-label="Fechar confirmação"><svg class="icon"><use href="#i-close"></use></svg></Button></div><p id="confirm-message" class="settings-copy"></p><div class="dialog-actions"><Button type="button" class="button-secondary" data-close-dialog="confirm-dialog">Cancelar</Button><Button type="button" class="button-primary" id="confirm-action">Confirmar</Button></div></dialog>
  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
  </Fragment>
  <script>
    import '../../nexo-financas-prototipo/data.js';
    import '../../nexo-financas-prototipo/app.js';
    import '../scripts/custom-selects.js';
  </script>
</Layout>
