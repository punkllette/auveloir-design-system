---
import '../../public/assets/overview/style.css';
import '../../public/assets/overview/fonts.css';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  canonicalURL?: string;
  image?: string;
}

const {
  title = 'AUVELOIR — Design System & Portfolio',
  description = 'Mello, estúdio digital independente da AUVELOIR. Projetos de design e desenvolvimento web com foco em experiências digitais, funcionalidade e performance.',
  ogDescription = 'Presença digital à altura do que você faz. Conheça os projetos e experiências digitais de Mello.',
} = Astro.props;
const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.props.canonicalURL ?? Astro.url.pathname, siteURL).href;
const imageURL = new URL(Astro.props.image ?? '/images/og-default.jpg', siteURL).href;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
<!-- Google Analytics -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4VKWS9Y7E4"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-4VKWS9Y7E4');
</script>
<!-- End Google Analytics -->
<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-T748W2KW');</script>
<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#090B10" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageURL} />
    <title>{title}</title>
    <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/portfolio-1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/portfolio-2.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T748W2KW"
height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <SiteNavbar />
    <slot name="header" />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0;
    left: 1rem;
    z-index: 1000;
    transform: translateY(-150%);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: #C41632;
    color: #fff;
    text-decoration: none;
  }

  .skip-link:focus-visible {
    top: 1rem;
    transform: none;
  }
</style>
