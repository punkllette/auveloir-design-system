---
import '../../public/assets/overview/style.css';
import '../../public/assets/overview/fonts.css';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  canonicalURL?: string;
  image?: string;
}

const {
  title = 'AUVELOIR — Design System & Portfolio',
  description = 'Mello, estúdio digital independente da AUVELOIR. Projetos de design e desenvolvimento web com foco em experiências digitais, funcionalidade e performance.',
  ogDescription = 'Presença digital à altura do que você faz. Conheça os projetos e experiências digitais de Mello.',
} = Astro.props;
const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.props.canonicalURL ?? Astro.url.pathname, siteURL).href;
const imageURL = new URL(Astro.props.image ?? '/images/og-default.jpg', siteURL).href;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#090B10" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageURL} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <SiteNavbar />
    <slot name="header" />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0;
    left: 1rem;
    z-index: 1000;
    transform: translateY(-150%);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: #C41632;
    color: #fff;
    text-decoration: none;
  }

  .skip-link:focus-visible {
    top: 1rem;
    transform: none;
  }
</style>
