---
import BeamButton from './BeamButton.astro';
import NavButton from './NavButton.astro';
---
    <nav class="glass-nav animate-fade-up">

        <a href="#" style="display: flex; align-items: center; gap: 0.85rem; text-decoration: none;">

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="30" height="30" role="img" aria-label="AUVELOIR">

                <path d="M48.85298 17.85867 A22 22 0 1 0 53.25037 37.69402" stroke="#F0F1F3" stroke-width="4.2" fill="none" stroke-linecap="round"/>

                <circle cx="53.47851" cy="27.23833" r="4.2" fill="#C41632"/>

            </svg>

            <span style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: var(--text-main); letter-spacing: 0.08em;">AUVELOIR</span>

        </a>

        <div class="nav-links">

            <a href="#about">Resumo</a>

            <a href="#projects">Projetos</a>

            <a href="#contact">Contato</a>

        </div>

        <details class="mobile-nav">
            <summary>Menu <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
            <div class="mobile-nav-panel">
                <a href="#about">Resumo</a>
                <a href="#projects">Projetos</a>
                <a href="#contact">Contato</a>
                <a class="mobile-nav-cta" href="#contact">Iniciar Projeto</a>
            </div>
        </details>

        <NavButton href="#contact">Iniciar Projeto</NavButton>

    </nav>



    <header class="hero-section hero" id="hero">

        <!-- Atmosfera de fundo Void Black com iluminação Event Red contida -->

        <div class="bg-aura-wrapper" aria-hidden="true">

            <div class="aura aura-1"></div>

            <div class="bg-noise"></div>

        </div>



        <div class="container">

            <div class="hero-content">

                <!-- Coluna Editorial: Apresentação e Posicionamento -->

                <div class="hero-text">

                    <!-- 1. Identificação e Descrição do Estúdio -->

                    <div class="studio-badge animate-blur-in delay-100">

                        <span class="badge-dot" aria-hidden="true"></span>

                        <span class="studio-name">MELLO</span>

                        <span class="studio-divider">/</span>

                        <span class="studio-desc">Estúdio digital independente</span>

                    </div>



                    <!-- 2. Título Principal em Duas Linhas Limpas -->

                    <h1 class="headline animate-blur-in delay-200">

                        Presença digital<br>

                        <span>à altura do que você faz.</span>

                    </h1>



                    <!-- 3. Texto de Apoio Enxuto e Elegante -->

                    <p class="subheadline animate-fade-up delay-200">

                        Sou Mello. Crio sites e experiências digitais com foco em design autoral, funcionalidade e performance.

                    </p>



                    <!-- 4. Ação Principal de Maior Destaque -->

                    <div class="cta-group animate-fade-up delay-300">

                        <BeamButton href="#projects">
                            Explorar Portfólio
                            <i data-lucide="arrow-up-right" style="margin-left: 0.6rem; width: 1.1rem; height: 1.1rem;" aria-hidden="true"></i>
                        </BeamButton>

                    </div>



                    <!-- 5. Assinatura Complementar Discreta -->

                    <div class="hero-signature animate-fade-up delay-300">

                        Design · Desenvolvimento · Experiências digitais

                    </div>

                </div>



                <!-- Coluna Direita: Elemento Visual Autoral com Ícones Flutuantes ao Redor (Igual ao Original) -->

                <div class="hero-visual-column animate-blur-in delay-200">

                    <div class="image-glow" aria-hidden="true"></div>

                    

                    <!-- Ícones de Ferramentas Flutuando em Volta do Card -->

                    <div class="tool-icon animate-float" style="top: 6%; left: 0; animation-duration: 7s;" title="JavaScript">

                        <span class="iconify" data-icon="logos:javascript" aria-hidden="true"></span>

                    </div>

                    <div class="tool-icon animate-float" style="top: 16%; right: -6%; animation-duration: 5s; animation-delay: 1s;" title="CSS3">

                        <span class="iconify" data-icon="logos:css-3" aria-hidden="true"></span>

                    </div>

                    <div class="tool-icon animate-float" style="bottom: 12%; left: -6%; animation-duration: 8s; animation-delay: 2s;" title="Python">

                        <span class="iconify" data-icon="logos:python" aria-hidden="true"></span>

                    </div>

                    <div class="tool-icon animate-float" style="bottom: 22%; right: -8%; animation-duration: 6s; animation-delay: 0.5s;" title="Microsoft Power BI">

                        <span class="iconify" data-icon="logos:microsoft-power-bi" aria-hidden="true"></span>

                    </div>



                    <div class="architectural-crest animate-float" aria-hidden="true">

                        <svg viewBox="0 0 400 400" class="crest-svg" fill="none" xmlns="http://www.w3.org/2000/svg">

                            <!-- Grade de Coordenadas de Precisão Arquitetônica -->

                            <circle cx="200" cy="200" r="160" stroke="#A7ADBA" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="4 4"/>

                            <circle cx="200" cy="200" r="115" stroke="#F0F1F3" stroke-opacity="0.18" stroke-width="1.2"/>

                            <line x1="200" y1="20" x2="200" y2="380" stroke="#A7ADBA" stroke-opacity="0.08" stroke-width="1"/>

                            <line x1="20" y1="200" x2="380" y2="200" stroke="#A7ADBA" stroke-opacity="0.08" stroke-width="1"/>

                            

                            <!-- Símbolo original da AUVELOIR, centralizado na grade -->

                            <g transform="translate(120 120) scale(2.5)">
                                <path d="M48.85298 17.85867 A22 22 0 1 0 53.25037 37.69402" stroke="#F0F1F3" stroke-width="4.2" stroke-linecap="round"/>
                                <circle cx="53.47851" cy="27.23833" r="4.2" fill="#C41632"/>
                            </g>

                        </svg>



                        <div class="crest-caption">

                            <span class="crest-brand">AUVELOIR</span>

                            <span class="crest-coords">ESTÚDIO DIGITAL · WEB DESIGN</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </header>
<script is:inline>
  const mobileNav = document.querySelector('.mobile-nav');
  mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { mobileNav.open = false; }));
  mobileNav?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      mobileNav.open = false;
      mobileNav.querySelector('summary').focus();
    }
  });
</script>
