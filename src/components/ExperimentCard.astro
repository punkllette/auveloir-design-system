---
import Icon from './Icon.astro';
interface Props {
  category: string;
  number: string;
  status: string;
  title: string;
  descriptionBefore: string;
  emphasis?: string;
  descriptionAfter?: string;
  author: string;
  role: string;
  icon: string;
  duplicate?: boolean;
}

const {
  category, number, status, title, descriptionBefore, emphasis,
  descriptionAfter = '', author, role, icon, duplicate = false,
} = Astro.props;
---
<div class="testimonial-card" aria-hidden={duplicate ? 'true' : undefined} style="border-top: 2px solid var(--primary-border);">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--primary-light); background: var(--primary-subtle); padding: 0.25rem 0.6rem; border-radius: 4px; font-weight: 500;">{category} &bull; EXP. {number}</span>
    <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">STATUS: {status}</span>
  </div>
  <div class="testimonial-text"><h3>{title}</h3> <p>{descriptionBefore}{emphasis && <em>{emphasis}</em>}{descriptionAfter}</p></div>
  <div class="testimonial-author" style="border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1.5rem; display: flex; align-items: center; gap: 0.85rem;">
    <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(196, 22, 50, 0.12); border: 1px solid rgba(196, 22, 50, 0.25); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <Icon name={`lucide:${icon}`} style="width: 18px; height: 18px; color: var(--primary);" />
    </div>
    <div class="author-info">
      <span class="author-name">{author}</span>
      <span class="author-role" style="font-family: var(--font-mono); font-size: 0.75rem;">{role}</span>
    </div>
  </div>
</div>

<style>
  /* Keep the original inline title and description appearance. */
  .testimonial-text h3 {
    display: inline;
    margin: 0;
    font: inherit;
    font-weight: 600;
    color: var(--text-main);
  }
  .testimonial-text p {
    display: inline;
    margin: 0;
    font: inherit;
  }
</style>
